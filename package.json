{
  "name": "ecommerce-be",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "pre-check": "biome check --write . && tsc --noEmitOnError",
    "fix": "biome check --fix --unsafe",
    "dev": "tsx watch --no-warnings --env-file=.env server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "generate:spec": "tsx --no-warnings scripts/generate-openapi.ts",
    "generate:types": "pnpm generate:spec && openapi-typescript openapi.json -o src/types/api.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^6.2.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "mongoose": "^9.5.0",
    "morgan": "^1.10.1",
    "redis": "^5.12.1",
    "slugify": "^1.6.9",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^6.0.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.6.0",
    "@types/swagger-ui-express": "^4.1.8",
    "openapi-typescript": "^7.13.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.21.0"
  }
}
